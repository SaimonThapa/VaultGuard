# --- Local-only / private (shared with teammates manually, never published) ---
docs/
/CLAUDE.md
.claude/
.playwright-mcp/

# --- Secrets: never commit real env files ---
.env
.env.*
!.env.example

# --- Python / backend ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Database files (contain vault data) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/

# --- Node / frontend (see also frontend/.gitignore) ---
node_modules/
dist/

# --- Editors / OS / logs ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
