# --- Local-only / private (shared with teammates manually, never published) ---
docs/
/CLAUDE.md
.claude/
skills-lock.json
.playwright-mcp/

# --- Secrets: never commit real env files ---
.env
.env.*
!.env.example

# --- Python / backend ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Files the app itself downloads: never commit (they hold key material or ciphertext) ---
vaultguard-backup-*.json
vaultguard-recovery-key-*.txt
*.pem
*.key

# --- Database files (contain vault data) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/

# --- Node / frontend (see also frontend/.gitignore) ---
node_modules/
dist/

# --- Tool caches and build leftovers ---
.mypy_cache/
.vite/
coverage/
*.tsbuildinfo
vite.config.js.timestamp-*

# --- Scratch / test leftovers (browser checks, screenshots, temp files) ---
/e2e-*
/*.png
*.tmp
*.bak
*.orig
*.swp

# --- Editors / OS / logs ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
