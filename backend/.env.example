# Copy to .env (never commit .env). Every var is listed; defaults are shown.
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required secrets (the app refuses to start with these placeholders unless DEBUG=true) ---
JWT_SECRET=change-me-generate-with-python-secrets
OTP_PEPPER=change-me-generate-with-python-secrets

# Origin allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database location, relative to the backend/ folder.
DATABASE_URL=sqlite:///./data/vaultguard.db

# true enables /docs and /openapi.json. Keep false outside local development.
DEBUG=false

# true when served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# Sessions and auto-lock (minutes / days).
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
VAULT_IDLE_MINUTES=10

# Login + unlock lockout.
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Email one-time codes.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60

# Argon2id for the master key (time cost, memory in KiB, parallelism).
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4

# Have I Been Pwned range API (false for offline demos).
HIBP_ENABLED=true
HIBP_TIMEOUT_SECONDS=3

# Optional SMTP. Leave unset to print emails (with their codes) to the backend log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
