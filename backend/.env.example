# Copy to .env (never commit .env). All values here are safe local-dev placeholders.

# Origin allowed by CORS (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# SQLite database location, relative to the backend/ folder.
DATABASE_URL=sqlite:///./data/vaultguard.db

# true enables /docs and /openapi.json. Keep false outside local development.
DEBUG=false
