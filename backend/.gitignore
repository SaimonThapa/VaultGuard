# Backend-only ignore rules. Keeps secrets, the database and local clutter out of Git even if the
# root .gitignore hasn't been pushed yet. (Same file is in both backend hand-off zips.)

# Secrets: never commit real env files (the example file is the template)
.env
.env.*
!.env.example

# Virtual environment and Python caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The database holds (encrypted) vault data
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Files the app lets users download: they hold key material or ciphertext
vaultguard-backup-*.json
vaultguard-recovery-key-*.txt
*.pem
*.key

# Logs and scratch files
*.log
*.tmp
*.bak
*.orig
